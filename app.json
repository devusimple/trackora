{
  "expo": {
    "name": "Trackora",
    "slug": "trackora",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": [
      "trackora",
      "finance",
      "money",
      "tracker"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.devusimple.trackora",
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-font",
        {}
      ],
      "expo-file-system"
    ],
    "extra": {
      "eas": {
        "projectId": "4b176c66-9a65-482a-8179-c9a2e581149b"
      }
    },
    "owner": "devusimple"
  }
}
